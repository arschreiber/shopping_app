# Kopie als `.env` anlegen. Diese Datei gehört *nicht* ins Repo.

# ---------------------------------------------------------------------------- Bring!
# Eigenes Bot-Konto anlegen (general_plan.md §6 Nr. 2), z. B. name+app@example.com,
# und es zur gemeinsamen Bring!-Liste einladen. Vorteile: das Sperr-Risiko trifft nur
# den Bot, Push-Nachrichten funktionieren, und die privaten Passwörter bleiben draußen.
#
# Solange hier nichts steht, erzeugt die App nur den Text-Export - alles andere
# funktioniert normal.
MEALPLAN_BRING_SYNC=text          # "bring" aktiviert den echten Push
MEALPLAN_BRING_EMAIL=
MEALPLAN_BRING_PASSWORD=
MEALPLAN_BRING_LIST_NAME=         # leer = die erste Liste des Kontos

# --------------------------------------------------------------------------- Angebote
# Phase 2. Erst einschalten, wenn Phase 1 drei Wochen im Alltag gehalten hat.
MEALPLAN_OFFER_FETCH_ENABLED=false
MEALPLAN_KORBUNIO_URL=http://korbunio:8000

# ---------------------------------------------------------------------------- Betrieb
MEALPLAN_DATA_DIR=/data
MEALPLAN_LOG_LEVEL=INFO
MEALPLAN_BACKUP_KEEP=7

# Nur für das caddy-Profil (HTTPS im Tailnet, für die PWA auf dem Homescreen)
MEALPLAN_TAILNET_HOST=
